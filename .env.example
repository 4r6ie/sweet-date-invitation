# WhatsApp number that receives the date confirmation.
#
# Digits only, including the country code — no "+", spaces or dashes.
# Example for a Philippine number: 639171234567
#
# Copy this file to `.env.local` and fill in your number.
# `.env.local` is git-ignored, so the number never reaches the public repo.
# When this is empty, the "Confirm Our Date" button is hidden.
VITE_WHATSAPP_NUMBER=
